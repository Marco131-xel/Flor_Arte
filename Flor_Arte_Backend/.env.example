# Plantilla vacia: Spring Boot no carga .env automaticamente; exportar en el proceso/IDE.
DB_URL=jdbc:postgresql://localhost:5432/florarte
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
AUTH_CODE_SECRET=
JWT_EXPIRATION=3600
CORS_ALLOWED_ORIGINS=http://localhost:5173
AUTH_RECOVERY_URL=http://localhost:5173/restablecer-contrasena
MAIL_USERNAME=
MAIL_PASSWORD=
# MAIL_FROM=
# Solo prod: origenes HTTPS externos separados por comas; obligatorio.
# SPRING_PROFILES_ACTIVE=prod
# PRODUCTION_CORS_ORIGINS=https://florarte.example
# AUTH_RECOVERY_URL=https://florarte.example/restablecer-contrasena
# Bootstrap opcional de una instalacion nueva; hash BCrypt en secreto montado, nunca password aqui.
# BOOTSTRAP_ADMIN_ENABLED=false
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_HASH_FILE=/run/secrets/florarte_admin_hash

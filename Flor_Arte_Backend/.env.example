# Variables del proceso de Spring Boot. No usar prefijo VITE_.
# Google: contraseña de aplicación, nunca la contraseña normal de Gmail.
MAIL_USERNAME=
MAIL_PASSWORD=
# Opcional: remitente autorizado; por defecto usa MAIL_USERNAME.
# MAIL_FROM=tu-cuenta@gmail.com
# Desarrollo; en producción usar HTTPS y la dirección real del frontend.
AUTH_RECOVERY_URL=http://localhost:5173/restablecer-contrasena
# Secreto aleatorio de al menos 32 bytes. Si se omite, utiliza jwt.secret.
# Generar localmente con: openssl rand -hex 32
# AUTH_CODE_SECRET=GENERAR_UN_SECRETO_ALEATORIO_DE_32_BYTES_O_MAS
CORS_ALLOWED_ORIGINS=http://localhost:5173
